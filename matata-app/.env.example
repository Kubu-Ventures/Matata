# Copy to .env.local and fill in. .env.local is gitignored.

# Base URL of the Matata backend API, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Privy application ID for the email OTP login flow.
# Create an app at https://dashboard.privy.io, then:
#   - User management > Authentication: enable Email, disable everything else.
#   - User management > Authentication > Advanced: turn on
#     "Return user data in an identity token".
# This value MUST match PRIVY_APP_ID on the backend, or token verification
# fails on an audience mismatch for every login.
NEXT_PUBLIC_PRIVY_APP_ID=
